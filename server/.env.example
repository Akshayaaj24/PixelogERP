# MongoDB Atlas connection string (free cluster at mongodb.com/atlas)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/pixelog-erp
# Any long random text
JWT_SECRET=change-this-to-a-long-random-secret
PORT=5000
# Your React URL in production, e.g. https://erp.pixelog.in
CLIENT_URL=http://localhost:5173
# Claude AI — create a key at platform.claude.com → API Keys
ANTHROPIC_API_KEY=
